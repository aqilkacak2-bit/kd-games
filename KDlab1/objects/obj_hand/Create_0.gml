/// obj_hand - Create
// One of the character's arms. obj_player creates two: side = "front" and side = "back".
//   no gun / holstered : hangs from its shoulder and swings with the walk (back arm = opposite swing, darker)
//   gun out            : front hand holds the grip, back hand holds the front of the gun (two-handed)
owner = noone;
gun   = noone;
side  = "front";
image_speed = 0;
